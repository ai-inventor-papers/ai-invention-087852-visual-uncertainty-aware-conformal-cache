\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Hit ratio comparison across three workload regimes. VUCCA matches LRU across all regimes (0.479, 0.441, 0.413) while providing conformal coverage guarantees. ARC2 dominates at $\approx $92\% due to ghost-list advantage. VUCCA\_no\_sigmoid crashes to $\approx $0.15, confirming the soft-sigmoid is essential.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:fig2}{{2}{6}{Hit ratio comparison across three workload regimes. VUCCA matches LRU across all regimes (0.479, 0.441, 0.413) while providing conformal coverage guarantees. ARC2 dominates at $\approx $92\% due to ghost-list advantage. VUCCA\_no\_sigmoid crashes to $\approx $0.15, confirming the soft-sigmoid is essential}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Hit ratio comparison across workload regimes.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:hitratios}{{1}{6}{Hit ratio comparison across workload regimes}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Results}{7}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Main Comparison}{7}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Throughput (requests per total latency) across three regimes. VUCCA matches LRU throughput in all regimes. Lower throughput indicates higher average latency due to more cache misses. ARC2 achieves highest throughput due to its $\approx $92\% hit ratio.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:fig3}{{3}{7}{Throughput (requests per total latency) across three regimes. VUCCA matches LRU throughput in all regimes. Lower throughput indicates higher average latency due to more cache misses. ARC2 achieves highest throughput due to its $\approx $92\% hit ratio}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Ablation Study}{7}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Ablation study showing the impact of each VUCCA component on hit ratio relative to the full method. Removing soft-sigmoid causes the largest drop (-67\%). Removing ACI has no measurable effect. Reducing $K$ from 64 to 10 has negligible effect on hit ratio but increases coverage error. Entropy-based uncertainty slightly underperforms conformal intervals.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:fig4}{{4}{8}{Ablation study showing the impact of each VUCCA component on hit ratio relative to the full method. Removing soft-sigmoid causes the largest drop (-67\%). Removing ACI has no measurable effect. Reducing $K$ from 64 to 10 has negligible effect on hit ratio but increases coverage error. Entropy-based uncertainty slightly underperforms conformal intervals}{figure.4}{}}
